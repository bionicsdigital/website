# Public canonical origin (not a secret)
NEXT_PUBLIC_SITE_URL=https://www.bionicsenvirotech.com

# Server-only email configuration
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
FROM_EMAIL=
TO_EMAIL=
ORDERS_EMAIL=
CAREERS_EMAIL=

# Distributed rate limiting and idempotency (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Comma-separated exact HTTPS browser origins. Add preview/staging origins
# explicitly; wildcards, paths and insecure production origins are rejected.
ALLOWED_ORIGINS=https://www.bionicsenvirotech.com

# For non-Vercel hosting, set only to a header overwritten by your trusted proxy:
# cf-connecting-ip, fly-client-ip, or x-real-ip
TRUSTED_PROXY_IP_HEADER=

# Production defaults to fail closed if Redis is unavailable. Do not disable
# unless the hosting layer provides equivalent distributed enforcement.
SECURITY_REQUIRE_DISTRIBUTED_STORE=true

# Set true only when a MalwareScanner adapter is connected and verified.
# With true and no available scanner, career resume submissions fail closed.
MALWARE_SCANNING_ENABLED=false
